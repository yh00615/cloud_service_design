{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDuringSpecificPeriod",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "YYYY-01-01T00:00:00Z"
        },
        "DateLessThan": {
          "aws:CurrentTime": "YYYY-12-31T23:59:59Z"
        }
      }
    },
    {
      "Sid": "DenyOutsideSpecificPeriod",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "YYYY-01-01T00:00:00Z"
        }
      }
    },
    {
      "Sid": "DenyAfterSpecificPeriod",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "YYYY-12-31T23:59:59Z"
        }
      }
    }
  ]
}
